    "/analytics/data_extraction/email_parsing/": {
      "post": {
        "description": "Extract chargeback-related data from the provided email content, streamlining chargeback analysis and management.",
        "requestBody": {
          "description": "Email content containing transaction details and an API key for authentication.",
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "email_content": {
                    "type": "string",
                    "example": "Your transaction with reference number 12345ABC made on 15-Nov-2023 with Merchant XYZ for $1500 has been flagged for a chargeback due to unauthorized usage. Please provide supporting documents by 20-Nov-2023."
                  },
                  "api_key": {
                    "type": "string",
                    "example": "hhhhhhhhhh"
                  }
                },
                "required": [
                  "email_content",
                  "api_key"
                ]
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successfully extracted data from the email content.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "analyzed_data": {
                      "type": "object",
                      "properties": {
                        "reference_number": {
                          "type": "string"
                        },
                        "transaction_entity": {
                          "type": "string"
                        },
                        "amount": {
                          "type": "number"
                        },
                        "currency": {
                          "type": "string"
                        },
                        "date_of_transaction": {
                          "type": "string",
                          "format": "date"
                        },
                        "chargeback_reason": {
                          "type": "string"
                        },
                        "customer_information": {
                          "type": "object"
                        },
                        "additional_notes": {
                          "type": "string"
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Bad request due to missing email content.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string",
                      "example": "The 'email_content' field is required and cannot be empty."
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized request due to missing API key.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string",
                      "example": "Invalid API token."
                    }
                  }
                }
              }
            }
          },
          "403": {
            "description": "Forbidden request due to invalid API key.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string",
                      "example": "Email content missing in the request body."
                    }
                  }
                }
              }
            }
          },
          "500": {
            "description": "Internal server error due to JSON parsing failure.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string",
                      "example": "Failed to parse the response JSON."
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "TransactionData": {
        "type": "object",
        "required": [
          "transactionId",
          "amount",
          "timestamp",
          "accountDetails"
        ],
